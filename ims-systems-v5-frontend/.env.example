# IMS Systems V5 Frontend — public environment example
# Copy to .env.local for local development. Never commit secrets.
# Do not put secrets in VITE_* variables.

# V5 API base including version prefix (no trailing slash).
# Local Vite + separate backend:
#   VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1
# Docker / same-origin via Nginx reverse proxy:
#   VITE_API_BASE_URL=/api/v1
VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1

# Security provider:
#   development-stub — local/test only (forbidden in Vite mode=production)
#   auth0-openfga — Auth0 SPA (adapter lands in auth rollout M4)
# Docker image builds use --mode docker so the stub remains allowed locally.
VITE_SECURITY_PROVIDER=development-stub

# Auth0 SPA public config (required when VITE_SECURITY_PROVIDER=auth0-openfga).
# Never put Management API or OpenFGA secrets in VITE_* variables.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Optional Auth0 Organization id for *single-org demos only* (org_…).
# Leave empty for self-signup / multi-tenant (recommended).
VITE_AUTH0_ORGANIZATION_ID=

# OnlyOffice Document Server origin for DocsAPI (no trailing slash).
# Empty = Edit button hidden; preview stays Microsoft Office Online view embed.
# Must match backend ONLYOFFICE_URL when editing is enabled.
# VITE_ONLYOFFICE_URL=http://localhost:8088
