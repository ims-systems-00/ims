# IMS Systems V5 Frontend — public environment example
# Copy to .env.local for local development. Never commit secrets.
# Do not put secrets in VITE_* variables.

# V5 API base including version prefix (no trailing slash).
# Local Vite + separate backend:
#   VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1
# Docker / same-origin via Nginx reverse proxy:
#   VITE_API_BASE_URL=/api/v1
VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1

# Security provider. development-stub is forbidden in Vite mode=production.
# Docker image builds use --mode docker so the stub remains allowed locally.
VITE_SECURITY_PROVIDER=development-stub
