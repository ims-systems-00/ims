# Example environment overrides for Docker Compose (optional).
# Copy to `.env` next to docker-compose.yml if you need custom values.
# Compose already sets safe defaults — this file is documentation only.
# Never commit real secrets.

# Published host port for the frontend Nginx container
# (change the left side of ports in docker-compose.yml if needed)
# FRONTEND_HOST_PORT=7864

# Backend (set via docker-compose.yml environment by default)
# NODE_ENV=development
# PORT=3001
# MONGODB_URI=mongodb://mongodb:27017/ims_v5
# LOG_LEVEL=info
# SECURITY_PROVIDER=development-stub
