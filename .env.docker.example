# Copy to `.env` next to docker-compose.yml (gitignored).
# Compose reads this file for ${VAR} substitution — never commit real secrets.
#
#   cp .env.docker.example .env
#
# Docs: docs/development/DOCKER_COMPOSE.md

# ---------------------------------------------------------------------------
# Mode switch
# ---------------------------------------------------------------------------
# development-stub  → one-command demo (default if unset)
# auth0-openfga     → real Auth0 login + OpenFGA (fill sections below first)
SECURITY_PROVIDER=auth0-openfga
VITE_SECURITY_PROVIDER=auth0-openfga

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Compose Mongo (empty DB — fine for stub / fresh Auth0 orgs):
MONGODB_URI=mongodb://mongodb:27017/ims_v5_dev
# Your existing host Mongo (Auth0 users / orgs you already use with pnpm):
# MONGODB_URI=mongodb://host.docker.internal:27017/ims_v5_dev

# ---------------------------------------------------------------------------
# Ports (host)
# ---------------------------------------------------------------------------
# FRONTEND_HOST_PORT=7864
# BACKEND_HOST_PORT=3001
# ONLYOFFICE_HOST_PORT=8088
# OPENFGA_HOST_PORT=18080

# ---------------------------------------------------------------------------
# Files + OnlyOffice (Compose defaults are usually enough)
# ---------------------------------------------------------------------------
# FILES_LOCAL_SIGNING_SECRET=dev-local-files-signing-secret
# ONLYOFFICE_JWT_SECRET=dev-onlyoffice-jwt-secret
# Signed local upload/view URLs are opened by the browser. Prefer the
# frontend origin (nginx proxies /api) so uploads stay same-origin.
# FILES_LOCAL_PUBLIC_BASE_URL=http://localhost:7864
# V4 migrated documents keep `{orgId}-ims-static-resources-bucket`. With
# FILES_PROVIDER=local, set legacy AWS keys (usually V4 AWS_ID/AWS_SECRET)
# so previews can still sign S3 GET URLs for those buckets.
# AWS_LEGACY_BUCKET_SUFFIXES=-ims-static-resources-bucket
# AWS_LEGACY_ACCESS_KEY_ID=
# AWS_LEGACY_SECRET_ACCESS_KEY=
# AWS_LEGACY_REGION=eu-west-2
CLIENT_URL=http://localhost:7864

# ---------------------------------------------------------------------------
# Alice AI (optional). Empty keys → "Alice is not configured" in the UI.
# openai: set OPEN_AI_API_KEY | groq: set AI_PROVIDER=groq + GROQ_API_KEY
# ---------------------------------------------------------------------------
# AI_PROVIDER=openai
# OPEN_AI_API_KEY=
# OPEN_AI_MODEL=gpt-4o-mini
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# OpenFGA (Postgres in Compose). After: ./scripts/docker/openfga-bootstrap.sh
# ---------------------------------------------------------------------------
OPENFGA_API_URL=http://openfga:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
# Preferred: Auth0 FGA / Okta FGA OAuth client credentials (empty = local no-auth).
OPENFGA_CLIENT_ID=
OPENFGA_CLIENT_SECRET=
OPENFGA_API_TOKEN_ISSUER=
OPENFGA_API_AUDIENCE=
# Deprecated legacy static token — only used when client credentials are unset.
OPENFGA_API_TOKEN=
# OPENFGA_DB_PASSWORD=openfga

# ---------------------------------------------------------------------------
# Auth0 — backend (required when SECURITY_PROVIDER=auth0-openfga)
# Copy from ims-systems-v5-backend/.env
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER=
AUTH0_DB_CONNECTION=Username-Password-Authentication
AUTH0_SPA_CLIENT_ID=
AUTH0_ROPG_CLIENT_ID=
AUTH0_ROPG_CLIENT_SECRET=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Auth0 — frontend build (public). Copy from ims-systems-v5-frontend/.env.local
# Rebuild frontend after changing these: docker compose up -d --build frontend
# ---------------------------------------------------------------------------
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_ORGANIZATION_ID=

# Auth0 Dashboard → Application → URLs must include:
#   Allowed Callback URLs:  http://localhost:7864, http://localhost:3000
#   Allowed Logout URLs:    http://localhost:7864, http://localhost:3000
#   Allowed Web Origins:    http://localhost:7864, http://localhost:3000
