# IMS Systems V5 Backend — environment example
# Copy to .env and adjust. Never commit real .env files.

# development | test | production
NODE_ENV=development

# HTTP listen port
PORT=3001

# Dedicated V5 MongoDB database (must NOT be the V4 application database)
MONGODB_URI=mongodb://127.0.0.1:27017/ims_v5_dev

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Security provider:
#   development-stub — local/test only (forbidden when NODE_ENV=production)
#   auth0-openfga — Auth0 JWT + OpenFGA (adapters land in auth rollout M3/M6)
# Default for local/dev remains development-stub until those milestones.
SECURITY_PROVIDER=development-stub

# ---------------------------------------------------------------------------
# Auth0 + OpenFGA (required when SECURITY_PROVIDER=auth0-openfga)
# ---------------------------------------------------------------------------
# Auth0 tenant / API audience for org-user Bearer tokens (D-16 / D-20).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Optional; defaults to https://${AUTH0_DOMAIN}/ when empty.
AUTH0_ISSUER=

# Auth0 Database + BFF password session (embedded login/register).
# See docs/security/AUTH_SELF_SIGNUP.md — secrets never go in VITE_*.
AUTH0_DB_CONNECTION=Username-Password-Authentication
# Public SPA client id for dbconnections/signup + change_password.
AUTH0_SPA_CLIENT_ID=
# Confidential Regular Web App with Password + Refresh Token grants enabled.
AUTH0_ROPG_CLIENT_ID=
AUTH0_ROPG_CLIENT_SECRET=
# Machine-to-Machine app authorized for the Auth0 Management API
# (scopes: create:organizations, read:organizations, delete:grants,
# delete:sessions). Unlocks session revocation (N-13) and Auth0
# Organization provisioning at Go Live (N-09). Backend only.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# OpenFGA store (D-21). Backend only — never expose these to the Vite app.
# STORE_ID and MODEL_ID must be ULIDs (OpenFGA SDK validation).
OPENFGA_API_URL=http://127.0.0.1:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPENFGA_API_TOKEN=

# ---------------------------------------------------------------------------
# Email + queue (BullMQ / Redis / Mailtrap)
# ---------------------------------------------------------------------------

# Redis used by BullMQ email queues
REDIS_URL=redis://127.0.0.1:6379

# Master switch — false skips delivery (safe default for local/tests)
# For auth0-openfga staging: set true + Mailtrap/SendGrid credentials (N-07).
EMAIL_ENABLED=false

# mailtrap = catch emails in Mailtrap inbox (recommended locally)
# sendgrid = production SendGrid API
# logging  = log only (never sends)
EMAIL_PROVIDER=mailtrap

# Mailtrap SMTP (Email Testing → your Inbox → SMTP Settings → Nodemailer)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# Optional production path
SENDGRID_API_KEY=

MAIL_FROM=hello@imssystems.tech
MAIL_FROM_NAME=iMS Systems

# Comma-separated inboxes that receive Report Bug forwards
REPORT_BUG_SUPPORT_EMAILS=support@imssystems.tech

# true = enqueue on BullMQ (needs Redis + a worker)
# false = send immediately in-process via the transport
EMAIL_QUEUE_ENABLED=false

# true = run email workers inside the API process (local convenience only)
# Prefer a dedicated process in production: pnpm worker:email
EMAIL_WORKER_IN_API=false

# Worker tuning
EMAIL_TRANSACTIONAL_CONCURRENCY=5
EMAIL_BULK_CONCURRENCY=2
EMAIL_BULK_RATE_MAX=30
EMAIL_BULK_RATE_DURATION_MS=60000

# ---------------------------------------------------------------------------
# File Handler / S3
# ---------------------------------------------------------------------------

# Master switch — false uses in-memory fake URLs (no real bytes)
# For auth0-openfga staging: keep true with FILES_PROVIDER=local|s3 (N-06).
FILES_ENABLED=true

# s3 = AWS | local = disk under FILES_LOCAL_ROOT (demo) | memory = fake URLs (tests)
# Do not use memory with auth0-openfga — document uploads will not persist real bytes.
FILES_PROVIDER=local

# Demo disk storage (when FILES_PROVIDER=local)
FILES_LOCAL_ROOT=.local-files
# Optional: override when API is not on 127.0.0.1:PORT (e.g. Docker)
# FILES_LOCAL_PUBLIC_BASE_URL=http://127.0.0.1:3001
FILES_LOCAL_SIGNING_SECRET=dev-local-files-signing-secret

# Logical bucket name for uploads (local + non-prod S3)
AWS_PRIVATE_BUCKET=ims-v5-local-demo

AWS_REGION=eu-west-2

# Prefer standard names. Aliases also accepted: AWS_ID, AWS_SECRET
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Non-production private/shared bucket (alias: AWS_TEST_BUCKET_NAME)
AWS_PRIVATE_BUCKET=

# Production private bucket suffix (alias: AWS_BUCKET_NAME)
# Final bucket name = `${organizationId}${AWS_BUCKET_SUFFIX}`
AWS_BUCKET_SUFFIX=

# Public/media bucket for logos etc. (alias: AWS_PUBLIC_BUCKET_NAME)
AWS_PUBLIC_BUCKET=

# Signed URL TTLs (seconds). Defaults match V4 (~3h upload, ~12h view).
FILES_UPLOAD_URL_TTL_SECONDS=10800
FILES_VIEW_URL_TTL_SECONDS=43200

# Max single-file upload size in bytes (default 25 MiB)
FILES_MAX_UPLOAD_BYTES=26214400

# Browser origins for S3 CORS (used by `pnpm provision:files-buckets`;
# see docs/development/FILE_HANDLER_AWS.md)
FILES_CORS_ORIGINS=http://localhost:3000,http://localhost:7864

# Comma-separated allowed x-file-path values (empty list = any sanitized path)
ALLOWED_FILE_PATHS=agenda,audit_attachments,contract,inventory_software_attachments,minutes,sla,general,onboarding,isoEvidence,profile,cqcReport,cqcEvidence,risks,cips,tasks,incidents,crms,staffwallet

# ---------------------------------------------------------------------------
# Stripe billing (LIC-01 / N-09) — see docs/module-specifications/stripe-payments.md
# ---------------------------------------------------------------------------

# Master switch — false keeps Go Live / org billing as no-ops (safe for local stub)
STRIPE_ENABLED=false

# Server secret key (sk_test_… / sk_live_…). Never commit real values.
STRIPE_PRIVATE_KEY=

# Webhook signing secret (whsec_…) for POST /api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Recurring / one-off Stripe Price ids
STRIPE_BU_PRICE=
STRIPE_SA_PRICE=
STRIPE_USER_PRICE=
STRIPE_COMPLIANCE_PRICE=
STRIPE_ADD_MODULE_PRICE=
STRIPE_SUPPORT_PRICE=

# FE origin for Checkout success/cancel and Billing Portal return
CLIENT_URL=http://localhost:3000
