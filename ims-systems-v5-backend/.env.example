# IMS Systems V5 Backend — environment example
# Copy to .env and adjust. Never commit real .env files.

# development | test | production
NODE_ENV=development

# HTTP listen port
PORT=3001

# Dedicated V5 MongoDB database (must NOT be the V4 application database)
MONGODB_URI=mongodb://127.0.0.1:27017/ims_v5_dev

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Security provider. development-stub is forbidden when NODE_ENV=production.
# Future providers (Auth0/OpenFGA adapters) will be added later by senior engineers.
SECURITY_PROVIDER=development-stub
